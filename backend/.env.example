# Clé qui signe les jetons de connexion. Génère-la avec :
#   python -c "import secrets; print(secrets.token_hex(32))"
ALANDIA_SECRET_KEY=

# Fichier SQLite (créé avec les 35 parcs au premier démarrage).
# Par défaut : backend/instance/alandia.sqlite3
# ALANDIA_DATABASE=

# Origines autorisées (CORS), séparées par des virgules. "*" = toutes.
ALANDIA_CORS_ORIGINS=*
